# Autology 백엔드 환경 변수 (선택 사항)
# 이 파일을 `.env`로 복사한 뒤 값을 채우세요:  cp .env.example .env
# 모든 값은 선택 사항입니다. 비워두면 안전한 기본값으로 동작합니다.

# ── 웹 검색 제공자 (Research 에이전트) ────────────────────────────────
# 키가 없으면 Wikipedia 요약으로 자동 폴백합니다.
# Tavily:  https://tavily.com
TAVILY_API_KEY=
# Serper:  https://serper.dev
SERPER_API_KEY=

# ── Ollama 서버 주소 ─────────────────────────────────────────────────
# 기본값은 로컬 Ollama입니다. 원격/다른 포트를 쓸 때만 변경하세요.
OLLAMA_BASE=http://localhost:11434

# ── Ollama 자동 기동 비활성화 (escape hatch) ─────────────────────────
# 값을 채우면(예: 1) 앱 시작 시 Ollama를 자동으로 띄우지 않습니다.
# 테스트나 Ollama를 직접 관리하고 싶을 때 사용합니다.
# AUTOLOGY_SKIP_OLLAMA_AUTOSTART=
